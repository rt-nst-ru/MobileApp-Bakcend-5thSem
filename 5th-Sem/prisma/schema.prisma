// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String         @unique
  phone           String?
  bio             String?
  conversationIds String[]       @db.ObjectId
  conversations   Conversation[] @relation(fields: [conversationIds], references: [id])
  messages        Message[]

  @@map("users")
}

model Conversation {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  name       String?
  type       String    // "DM" | "GROUP"
  createdAt  DateTime  @default(now())
  createdBy  String    @db.ObjectId
  participants_ids String[]  @map("userIds") @db.ObjectId
  users            User[]    @relation(fields: [participants_ids], references: [id])
  messages         Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  content        String?      // empty for an attachment sent without a caption
  createdAt      DateTime     @default(now())
  senderId       String       @db.ObjectId
  sender         User         @relation(fields: [senderId], references: [id])
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  status         Json
  // Optional attachment (image or file). Null for plain text messages.
  fileId         String?      @db.ObjectId
  file           File?        @relation(fields: [fileId], references: [id])

  @@map("messages")
}

// An uploaded image or file. Clients send it as base64; it is stored as binary.
model File {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  mimeType   String
  size       Int       // size in bytes (decoded, not base64)
  kind       String    // "IMAGE" | "FILE"
  data       Bytes
  uploadedBy String    @db.ObjectId
  createdAt  DateTime  @default(now())
  messages   Message[]

  @@map("files")
}
